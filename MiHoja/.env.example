# Copia este archivo como ".env" y completa la clave real.
# Este proyecto usa Supabase como unica base de datos.
# Para frontend desacoplado en Next.js, el backend expone CORS hacia APP_FRONTEND_URL.

MIHOJA_DB_URL=jdbc:postgresql://aws-0-us-west-2.pooler.supabase.com:5432/postgres?sslmode=require
MIHOJA_DB_USERNAME=mihoja_app.TU_PROJECT_REF
MIHOJA_DB_PASSWORD=REEMPLAZA_CON_TU_DB_PASSWORD
APP_FRONTEND_URL=http://localhost:3000

# Opcional: exponer metricas prometheus en otro puerto
# MANAGEMENT_PORT=8081

# Almacenamiento (default local). Para Supabase Storage:
MIHOJA_STORAGE_PROVIDER=local
# SUPABASE_URL=https://TU_PROJECT_ID.supabase.co
# SUPABASE_SERVICE_KEY=TU_SERVICE_ROLE_KEY
# SUPABASE_STORAGE_BUCKET=mihoja
# SUPABASE_STORAGE_PUBLIC=true

# Si quieres usar Supabase Storage:
# MIHOJA_STORAGE_PROVIDER=supabase

# Alternativa equivalente:
# SUPABASE_DB_URL=jdbc:postgresql://aws-0-us-west-2.pooler.supabase.com:5432/postgres?sslmode=require
# SUPABASE_DB_USERNAME=mihoja_app.TU_PROJECT_REF
# SUPABASE_DB_PASSWORD=REEMPLAZA_CON_TU_DB_PASSWORD
